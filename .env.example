# =====================================================================
# App (Next.js + Supabase SSR — cliente del navegador)
# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# =====================================================================
# Tests de integración (Vitest contra Supabase local)
# Obtener estos valores ejecutando: `npx supabase status -o env`
# NO hardcodear claves reales; estos son solo placeholders.
#
# IMPORTANTE: estas variables las carga `tests/integration/setup-env.ts`
# desde `.env.test.local` (gitignored), NO desde `.env.local`. Crea ese
# archivo localmente con:  `npx supabase status -o env > .env.test.local`
# En CI se exportan directamente desde el workflow (ver .github/workflows/ci.yml).
# =====================================================================
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
CRON_SECRET=your-cron-secret-for-api-sync

# =====================================================================
# Google OAuth (Story 1.2)
# Credenciales del proveedor Google. supabase/config.toml las lee con env().
# Crea un `.env` raíz (gitignored) con valores reales para el flujo OAuth.
# En local, sin credenciales reales, el botón existe pero Google devolverá
# error; la validación automatizada del trigger usa auth.admin.createUser.
# Consíguelas en: https://console.cloud.google.com (OAuth 2.0 Client IDs).
# =====================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =====================================================================
# Zafronix API — Webhook (Epic 8 / Story 8.1)
# Clave secreta compartida para verificar firmas HMAC-SHA256 de los
# webhooks de Zafronix. Obtener del panel de Zafronix (Webhook Settings).
# =====================================================================
ZAFRONIX_WEBHOOK_SECRET=your-zafronix-webhook-secret
